{
  "name": "emada-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "translations:collect": "node --conditions=react-server --import tsx scripts/export-translation-candidates.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "tsx scripts/verify-practice-config.ts && tsx scripts/verify-translation-config.ts && tsx scripts/verify-news-classification.ts && node --conditions=react-server --import tsx scripts/seed-news-classification.ts && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:chat": "tsx scripts/migrate-practice-chat.ts",
    "db:migrate:content": "tsx scripts/migrate-lesson-content.ts",
    "admin:invite": "tsx scripts/invite-admin.ts",
    "db:migrate:localization": "tsx scripts/migrate-localization.ts",
    "db:migrate:translations": "tsx scripts/migrate-openrouter-translations.ts",
    "db:migrate:news-classification": "tsx scripts/migrate-news-classification.ts"
  },
  "dependencies": {
    "@next/env": "^16.3.4",
    "@radix-ui/react-slot": "^1.3.3",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "json5": "^2.2.3",
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.7",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
