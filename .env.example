BETTER_AUTH_URL=http://localhost:3000
# Neon Postgres, provisioned through Vercel Storage. POSTGRES_URL also works.
DATABASE_URL=
BETTER_AUTH_SECRET=
# Google OAuth web client. Server-only; never prefix these with NEXT_PUBLIC_.
# See docs/google-login.md for exact callback URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Administrator is provisioned with npm run admin:invite -- <email>.
# No automatic promotion based on an unverified signup email.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Dedicated inference key, capped at US$5/month in OpenRouter. Never NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Uses the same server credential for new news/post translations; manual catalog wins.
OPENROUTER_TRANSLATIONS_ENABLED=false
# Jev labels new model releases. US$0.50/month sub-budget within the shared US$5.
OPENROUTER_NEWS_CLASSIFICATION_ENABLED=false
# Direct test-branch connection for additive migration 006 (requires migration 002).
NEWS_CLASSIFICATION_MIGRATION_DATABASE_URL=
# Direct test-branch connection for additive migration 005 (requires migration 002).
OPENROUTER_TRANSLATION_MIGRATION_DATABASE_URL=
# Enable only after migration 002 is tested/applied and the key limit is verified.
PRACTICE_CHAT_ENABLED=false
# Direct branch connection for migration 002 only. Never falls back to production.
PRACTICE_MIGRATION_DATABASE_URL=

# Optional portal integrations. Server-only: never use NEXT_PUBLIC_.
# X API app-only bearer token with read access to users and user timelines.
# Configure access/credits in the X developer console before enabling.
# Without a token, Vozes uses a dated public selection via official oEmbed.
# oEmbed refreshes selected content only; new post discovery requires this token.
X_API_BEARER_TOKEN=
# Optional Artificial Analysis Data API key; its public leaderboard works without it.
# The API adds metrics such as coding, math and input/output token prices when available.
ARTIFICIAL_ANALYSIS_API_KEY=
# Direct test-branch connection for migration 004. Never falls back to DATABASE_URL.
LOCALIZATION_MIGRATION_DATABASE_URL=
